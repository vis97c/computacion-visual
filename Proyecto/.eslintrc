{
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "requireConfigFile": false,
        "sourceType": "module",
        "ecmaFeatures": {
            "jsx": true
        }
    },
    "env": {
        "node": true,
        "browser": true
    },
    "extends": [
        "@open-xamu-co/eslint-config"
    ],
    "overrides": [
        {
            "files": [
                "*.jsx"
            ],
            "extends": [
                "plugin:react/recommended"
            ],
            "rules": {
                "react/react-in-jsx-scope": "off"
            }
        }
    ]
}